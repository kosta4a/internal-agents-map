---
// ABOUTME: Renders one normalized claim with its citations and its qualifications.
// ABOUTME: Caveats and conflicts stay in the initial HTML, beside the statement.
import type { ClaimView } from '../lib/entry-view';

interface Props {
  claim: ClaimView;
  /** Hide the field label when a section heading already names the claim group. */
  showLabel?: boolean;
}

const { claim, showLabel = true } = Astro.props;
---
<article class="claim" id={claim.anchor} data-claim-id={claim.id}>
  {showLabel && <span class="claim-label">{claim.label}</span>}
  <p>{claim.text}</p>
  {claim.citations.length > 0 && (
    <p class="citations">
      {claim.citations.map((citation) => (
        <a
          class:list={['citation', citation.relation === 'contradicts' && 'citation-contradicts']}
          href={`#${citation.anchor}`}
        >
          <strong>{citation.number}</strong>
          {claim.showCitationRoles && <span> {citation.relationLabel}</span>}
        </a>
      ))}
    </p>
  )}
  {claim.contradicting.length > 0 && (
    <div class="conflict">
      <strong>Conflicting evidence</strong>
      <p>
        The preserved evidence disagrees about this statement. Read the qualifications above and
        source{claim.contradicting.length > 1 ? 's' : ''}{' '}
        {claim.contradicting.map((citation, index) => (
          <>{index > 0 && ', '}<a href={`#${citation.anchor}`}>{citation.number}</a></>
        ))}.
      </p>
    </div>
  )}
  {claim.qualification && <p class="qualification">{claim.qualification}</p>}
  {claim.caveats.length > 0 && (
    <dl class="caveats">
      {claim.caveats.map((caveat) => (
        <>
          <dt>{caveat.label}</dt>
          <dd>{caveat.value}</dd>
        </>
      ))}
    </dl>
  )}
</article>
