---
// ABOUTME: The frame the guides and the notes share, wrapped around the site shell.
// ABOUTME: It also carries the reading styles those pages use, ported from the old site.
import SiteLayout from './SiteLayout.astro';
import type { JsonLdNode } from '../lib/metadata';

interface Props {
  title: string;
  description: string;
  /** The canonical path of this page. */
  path: string;
  current?: 'catalog' | 'definitions' | 'notes' | 'methodology' | null;
  structuredData?: JsonLdNode | null;
  /** `notes` adds the reading width and type size the notes use. */
  variant?: 'guide' | 'notes';
  /** A note is an article; a guide is an ordinary page. */
  ogType?: 'website' | 'article';
  /** The publication date of an article, for link previews. */
  articlePublishedTime?: string | null;
}

const {
  title,
  description,
  path,
  current = null,
  structuredData = null,
  variant = 'guide',
  ogType = 'website',
  articlePublishedTime = null,
} = Astro.props;
---
<SiteLayout
  title={title}
  description={description}
  path={path}
  current={current}
  structuredData={structuredData}
  ogType={ogType}
  articlePublishedTime={articlePublishedTime}
>
  <div class:list={['guide', variant === 'notes' && 'notes']}>
    <slot />
  </div>
</SiteLayout>

<style is:global>
/* The guides and the notes read as documents: fine rules, wide measure, quiet labels. */
.guide-header { padding-bottom: 32px; }
.guide-header h1 { max-width: 700px; margin-top: 12px; }
.guide-header > p { max-width: 680px; }
.guide-header .lede { font-size: 14px; line-height: 1.5; margin-top: 24px; }
.guide p { line-height: 1.65; }
.guide section > p { max-width: 680px; }
.guide section > .eyebrow { margin-bottom: 12px; }
.guide section > h2 { margin-bottom: 8px; }
.guide section > h3 + p { margin-top: 12px; }
.guide section > p + p { margin-top: 16px; }
.guide section { padding: 32px 0; }
.guide section > h3 { margin-top: 32px; max-width: 680px; }
.guide h3 { font-size: 16px; font-weight: 500; }
.guide figure { margin: 32px 0; }
.guide figcaption { color: var(--muted); font-size: 12px; line-height: 1.65; margin-top: 24px; }
.guide blockquote { margin: 24px 0; padding: 8px 0; font-size: 14px; }
.diagram-number { display: block; color: var(--link); font-size: 12px; }

/* The chart shows two questions about an implementation, not a score. */
.quadrant-chart { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; }
.quadrant-y-axis { writing-mode: vertical-rl; transform: rotate(180deg); text-align: center; font-size: 12px; color: var(--muted); }
.quadrant-plot { aspect-ratio: 1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); border: 1px solid var(--sand-10); }
.quadrant-cell { position: relative; min-width: 0; }
.quadrant-cell:nth-child(odd) { border-right: 1px solid var(--sand-7); }
.quadrant-cell:nth-child(-n+2) { border-bottom: 1px solid var(--sand-7); background: var(--sand-2); }
.quadrant-cell:nth-child(n+3) { background: var(--sand-2); }
.quadrant-cell h3 { position: absolute; top: 12px; left: 14px; right: 14px; margin: 0; font-size: 12px; line-height: 1.35; font-weight: 500; color: var(--ink); letter-spacing: -.015em; }
.quadrant-cell h3 span { display: block; margin-bottom: 8px; color: var(--link); font-size: 12px; line-height: 1.3; font-weight: 400; }
.quadrant-cell:nth-child(n+3) h3 { top: auto; bottom: 12px; }
.quadrant-cell ul { margin: 0; padding: 0; list-style: none; }
.quadrant-cell li { position: absolute; left: 15%; top: 34%; max-width: 78%; font-size: 14px; padding-left: 16px; }
.quadrant-cell li:nth-child(2) { left: 33%; top: 65%; }
.quadrant-cell:nth-child(4) li { left: 12%; top: 15%; }
.quadrant-cell:nth-child(4) li:nth-child(2) { left: 33%; top: 37%; }
.quadrant-cell:nth-child(4) li:nth-child(3) { left: 20%; top: 60%; }
.quadrant-cell li::before { content: ""; position: absolute; width: 8px; height: 8px; background: var(--accent); border: 2px solid #fff; border-radius: 50%; left: 0; top: 5px; }
.quadrant-cell a { display: block; line-height: 1.35; text-decoration: none; }
.quadrant-cell a:hover { text-decoration: underline; }
.quadrant-cell a strong { font-weight: 400; }
.quadrant-cell a span { display: block; font-size: 12px; margin-top: 8px; }
.quadrant-cell li > strong { display: block; font-weight: 400; line-height: 1.35; }
.quadrant-cell li > span { display: block; font-size: 12px; line-height: 1.35; margin-top: 8px; }
.quadrant-cell .reference-marker { color: var(--sand-10); }
.quadrant-cell .reference-marker::before { background: #fff; border-color: var(--sand-10); }
.quadrant-cell li[data-chart-reference="deep-research"] { left: 5%; top: 42%; max-width: 40%; }
.quadrant-cell li[data-chart-reference="ready-made-task"] { left: 49%; top: 42%; max-width: 48%; }
.quadrant-cell li[data-chart-reference="general-assistant"] { left: 28%; top: 34%; max-width: 66%; }
.quadrant-cell li[data-chart-approach-id="doordash-code-review"] { left: 10%; top: 30%; max-width: 56%; }
.quadrant-cell li[data-chart-approach-id="posthog-stamphog"] { left: 15%; top: 72%; max-width: 46%; }
.quadrant-cell li[data-chart-approach-id="ramp-inspect"] { left: 60%; top: 76%; max-width: 35%; }
.quadrant-cell li[data-chart-approach-id="retool-retoolgpt"] { left: 48%; top: 10%; max-width: 48%; }
.quadrant-cell li[data-chart-approach-id="stripe-minions"] { left: 56%; top: 48%; max-width: 40%; }
.quadrant-cell li[data-chart-approach-id="brex-agent-platform"] { left: 10%; top: 30%; max-width: 58%; }
.quadrant-cell li[data-chart-approach-id="sentry-junior"] { left: 56%; top: 50%; max-width: 38%; }
.quadrant-cell li[data-chart-approach-id="shopify-internal-agents"] { left: 17%; top: 72%; max-width: 52%; }
.quadrant-x-axis { grid-column: 2; display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--muted); }
.quadrant-legend { display: flex; flex-wrap: wrap; gap: 12px 24px; margin: 24px 0 12px 32px; color: var(--muted); font-size: 12px; }
.quadrant-legend span { display: inline-flex; align-items: center; gap: 8px; }
.quadrant-legend i { width: 10px; height: 10px; border-radius: 50%; }
.quadrant-legend .catalog-marker { background: var(--accent); border: 2px solid var(--accent); }
.quadrant-legend .reference-marker-key { background: #fff; border: 2px solid var(--sand-10); }
.guide .quadrant-figure { max-width: 680px; }
.guide-faq details {
  background: var(--sand-3);
  border-radius: 10px;
  overflow: hidden;
}
.guide-faq details + details { margin-top: 12px; }
.guide-faq summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 40px;
  padding: 8px 12px;
  cursor: pointer;
  font-weight: 400;
  line-height: 1.5;
}
.guide-faq summary:hover { background: var(--sand-4); }
.guide-faq summary::before { content: none; }
.guide-faq summary .icon { flex: none; color: var(--sand-10); }
.guide-faq details[open] > summary .icon { transform: rotate(180deg); }
.guide-faq details p { margin: 0; padding: 0 12px 12px; max-width: 680px; color: var(--muted); }
.dimension-intro { display: grid; gap: 24px; margin-top: 24px; }
.dimension-intro h3 { font-size: 16px; line-height: 1.3; margin-bottom: 8px; }
.dimension-intro p { font-size: 14px; color: var(--muted); }

/* A company workflow supplies the context around model-directed work. */
.workflow-node { background: var(--sand-3); border-radius: 16px; padding: 24px; text-align: center; }
.workflow-node strong { display: block; font-weight: 400; margin-top: 12px; }
.workflow-context { background: var(--sand-3); }
.workflow-connector { text-align: center; color: var(--sand-10); font-size: 20px; line-height: 38px; }
.placement-notes { padding: 24px 0; margin-top: 24px; }
.placement-notes summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  cursor: pointer;
}
.placement-notes summary::before { content: none; }
.placement-notes summary .icon { flex: none; color: var(--sand-10); }
.placement-notes[open] > summary .icon { transform: rotate(180deg); }
.placement-notes ul { list-style: none; padding: 0; }
.placement-notes li { margin-top: 24px; font-size: 14px; }
.placement-notes li strong { font-weight: 400; }
.placement-notes li p { margin: 8px 0; }
.placement-notes .reference-placement { color: var(--muted); }

/* Definition illustrations share one visual vocabulary: a teal dot is the agent. */
.core-definition { padding: 64px 24px; margin: 24px 0; background: var(--sand-3); border-radius: 14px; text-align: center; }
.combination-title { font-size: 16px; line-height: 1.45; }
.combination-title strong { font-weight: 400; }
.guide .core-definition p { font-size: 16px; font-weight: 500; line-height: 1.4; margin: 0 auto; max-width: 440px; }
.guide .core-definition strong { font-weight: 500; }
/* A call to action stands clear of the paragraph that leads into it. */
.guide section > .button { margin-top: 16px; }
.scope-diagram { max-width: 360px; margin: 24px auto 0; }
.scope-diagram, .concept-pair svg { display: block; width: 100%; fill: none; stroke: var(--sand-10); stroke-width: 1.2; }
.scope-diagram text, .concept-pair svg text { fill: var(--muted); stroke: none; font: 12px Areal, sans-serif; }
.scope-diagram .agent-dot, .concept-pair svg .agent-dot { fill: var(--accent); stroke: var(--accent); }
.guide .concept-definition { font-size: 14px; line-height: 1.5; max-width: 610px; }
.concept-pair { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); max-width: 680px; margin: 24px 0; }
.guide .concept-pair figure { margin: 0; padding: 24px 16px; min-width: 0; }
.concept-pair figure + figure { border-left: 1px solid var(--sand-6); }
.guide .concept-pair figcaption { margin: 16px 0 0; line-height: 1.5; }
.concept-pair figcaption strong { display: block; color: var(--ink); font-size: 16px; margin-bottom: 8px; }
.concept-pair figcaption span { display: block; font-size: 14px; }
.concept-combination { max-width: 680px; margin: 32px 0; }
.guide .concept-combination > p { font-size: 16px; line-height: 1.45; margin: 0; }
/* The three questions read down the page as a table, one row each. */
.concept-combination dl {
  display: grid;
  grid-template-columns: max-content minmax(0, 1fr);
  gap: 0;
  margin: 16px 0;
  border-top: .5px solid var(--sand-6);
}
.concept-combination dl > div { display: contents; }
.concept-combination dt, .concept-combination dd {
  padding: 12px 0;
  border-bottom: .5px solid var(--sand-6);
  font-size: 14px;
}
.concept-combination dt { color: var(--muted); padding-right: 24px; }
.concept-combination dd { margin: 0; }
.guide .concept-combination .combination-note { font-size: 14px; color: var(--muted); }

/* Notes use the same fine rules, type, and restrained diagram accents. */
.notes { font-size: 14px; }
.notes .note-observation {
  padding: 0;
  margin: 32px 0;
}
.notes .note-observation .eyebrow,
.notes .note-observation h2 {
  display: inline;
  font-size: 16px;
  margin: 0;
}
.notes .note-observation .eyebrow { color: var(--sand-10); }
.notes .note-observation .eyebrow::after { content: ": "; }
/* The findings under the title form one panel: a row each, divided. */
.notes .note-observation > h2 ~ p:not(.note-question) {
  margin: 0;
  padding: 16px;
  background: var(--sand-3);
  border-top: .5px solid var(--sand-6);
}
.notes .note-observation > h2 + p:not(.note-question) {
  margin-top: 16px;
  border-top: 0;
  border-radius: 14px 14px 0 0;
}
.notes .note-observation > p:not(.note-question):has(+ .note-question) {
  border-radius: 0 0 14px 14px;
}
.notes .note-observation > :first-child { margin-top: 0; }
.notes .note-observation > :last-child { margin-bottom: 0; }
.notes .note-meta { font-size: 12px; color: var(--sand-10); }
.notes .guide-header { padding-bottom: 32px; }
.notes .guide-header > * { max-width: 680px; }
.notes .note-list, .note-detail > article { max-width: 680px; }
.note-preview { position: relative; margin-bottom: 40px; cursor: pointer; }
.note-preview h2 a::after { content: ""; position: absolute; inset: 0; }
.note-preview h2 { margin: 0 0 8px; }
.note-preview h2 a { color: var(--ink); text-decoration: none; }
.note-summary { font-size: 14px; color: var(--sand-10); max-width: 580px; }
.note-preview:hover h2 a { color: var(--sand-11); }
.note-preview:hover .note-summary { color: var(--sand-9); }
.note-preview:hover .tag { color: var(--sand-11); }
.notes-editorial { max-width: 620px; padding: 24px 0 32px; color: var(--muted); font-size: 14px; }
.note-back { display: inline-block; margin-bottom: 32px; font-size: 14px; }
.note-detail h1 { max-width: 640px; }
.notes section { padding: 32px 0; }
.notes blockquote { margin: 32px 0 8px; padding: 8px 0 0; font-size: 16px; }
.notes .quote-credit { color: var(--muted); font-size: 14px; margin: 0 0 24px; }
.notes .note-diagram { margin: 32px 0 0; }
.note-flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; align-items: stretch; }
.note-arrow { display: none; }
.note-node {
  min-width: 0;
  background: var(--sand-3);
  border-radius: 14px;
  padding: 16px;
}
.note-node > span { display: block; color: var(--muted); font-size: 14px; margin-bottom: 8px; }
.note-node strong { display: block; font-size: 16px; font-weight: 400; line-height: 1.4; }
.note-node small { display: block; color: var(--muted); font-size: 14px; line-height: 1.5; margin-top: 6px; }
.note-node-accent strong { color: var(--link); }
.note-diagram-tail { margin-top: 16px; font-size: 14px; }
.notes .note-diagram figcaption {
  margin-top: 16px;
  font-size: 12px;
  color: var(--sand-10);
}
.notes figcaption { font-size: 14px; margin-top: 16px; }
.note-question { margin: 16px 0 0; font-size: 14px; color: var(--sand-12); }
.note-question strong { font-weight: 400; color: var(--sand-10); }
.note-question strong::after { content: ": "; }
.guide .note-sources > h2 { margin-bottom: 16px; }
.note-sources ol { padding-left: 24px; margin: 0; font-size: 14px; }
.note-sources ol li + li { margin-top: 16px; }
.note-sources li span { display: block; color: var(--muted); margin-top: 8px; }
.note-sources .resource-links { font-size: 14px; }
.note-next { display: grid; gap: 12px; padding: 24px 0 32px; font-size: 14px; }
.note-versions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
.note-versions > div { padding-top: 16px; }
.note-versions .diagram-number { font-size: 14px; margin-bottom: 12px; }
.note-versions strong { display: block; font-size: 16px; line-height: 1.4; font-weight: 400; }
.note-versions p { font-size: 14px; color: var(--muted); margin-top: 8px; }
.note-versions .note-version-current { border-top: 2px solid var(--accent); }

@media (max-width: 600px) {
  .guide-header h1 { font-size: 32px; }
  .guide-header { padding-bottom: 32px; }
  .guide section { padding: 32px 0; }
  .quadrant-chart { grid-template-columns: 18px minmax(0, 1fr); gap: 8px; }
  .quadrant-plot { aspect-ratio: .82; }
  .quadrant-cell h3 { font-size: 12px; left: 6px; right: 6px; top: 6px; }
  .quadrant-cell h3 span { display: none; }
  .quadrant-cell:nth-child(n+3) h3 { bottom: 6px; }
  .quadrant-cell li { font-size: 12px; padding-left: 12px; }
  .quadrant-cell a span, .quadrant-cell li > span { font-size: 12px; }
  .quadrant-cell li::before { width: 6px; height: 6px; border-width: 1px; top: 4px; }
  .quadrant-cell li:nth-child(2) { left: 22%; }
  .quadrant-cell:nth-child(4) li:nth-child(2) { left: 28%; }
  .quadrant-cell:nth-child(3) li > span { display: none; }
  .quadrant-x-axis, .quadrant-y-axis { font-size: 12px; }
  .quadrant-legend { margin-left: 24px; gap: 8px 16px; }
  .core-definition { padding: 40px 20px; }
  .scope-diagram { max-width: 300px; }
  .concept-pair { grid-template-columns: 1fr; }
  .concept-pair figure + figure { border-left: 0; border-top: 1px solid var(--sand-6); }
  .concept-pair svg { max-width: 320px; margin: auto; }
  .concept-combination dl { grid-template-columns: max-content minmax(0, 1fr); }
  .workflow-node { padding: 16px 12px; }
  .workflow-node .eyebrow { font-size: 12px; }
  .workflow-node strong { font-size: 14px; }
  .notes .note-diagram { padding: 24px; }
  .note-flow { grid-template-columns: 1fr; gap: 16px; }
  .note-node > span { margin-bottom: 8px; }
  .note-arrow { transform: rotate(90deg); width: fit-content; }
  .note-versions { grid-template-columns: 1fr; gap: 24px; }
  .note-versions .diagram-number { margin-bottom: 8px; }
  .note-meta span { display: block; margin: 8px 0 0; }
}
</style>
