---
// ABOUTME: The page of one catalog implementation, in the order the contract sets.
// ABOUTME: Every section is built from normalized claims, never from stored HTML.
import SiteLayout from '../../layouts/SiteLayout.astro';
import Arrowed from '../../components/Arrowed.astro';
import Claim from '../../components/Claim.astro';
import Icon from '../../components/Icon.astro';
import CompanyLogo from '../../components/CompanyLogo.astro';
import ResearchDetails from '../../components/ResearchDetails.astro';
import SourceList from '../../components/SourceList.astro';
import { loadCatalog } from '../../lib/catalog';
import { entryView } from '../../lib/entry-view';
import { assertPublishableId, canonicalUrl } from '../../lib/routes';
import {
  SITE_NAME,
  breadcrumbNode,
  metaDescription,
  structuredData,
  webPageNode,
} from '../../lib/metadata';

export function getStaticPaths() {
  return loadCatalog().approaches.map((approach) => {
    assertPublishableId(approach.id);
    return { params: { id: approach.id } };
  });
}

const { id } = Astro.params as { id: string };
const entry = entryView(loadCatalog(), id);

const title = `${entry.agentName} at ${entry.company} · ${SITE_NAME}`;
const description = metaDescription(`${entry.company} — ${entry.agentName}. ${entry.summaryText}`);
const url = canonicalUrl(entry.path);
const graph = structuredData([
  webPageNode({ url, name: title, description, dateModified: entry.reviewedAt }),
  breadcrumbNode(url, [
    { name: 'Catalog', path: '/' },
    { name: `${entry.company} — ${entry.agentName}`, path: entry.path },
  ]),
]);

// Invocation and interfaces are classifications, so they sit with the other facts.
// Without a reported workflow the entry has no "How it works" material to show.
const hasHowItWorks = entry.workflowClaims.length > 0;
const invocation = entry.invocation.filter((item) => item.id !== 'unknown');
const hasImplementation = entry.architectureClaims.length > 0 || entry.otherClaims.length > 0;
const hasResults =
  entry.metricClaims.length > 0 ||
  entry.resultStatementClaims.length > 0 ||
  entry.lessonClaims.length > 0;
const hasRelated = entry.relatedEntries.length > 0 || entry.relatedNotes.length > 0;
---
<SiteLayout title={title} description={description} path={entry.path} structuredData={graph}>
  <article class="entry-page" data-approach-id={entry.id}>
    <header class="entry-header">
      <CompanyLogo company={entry.companyView} size={40} eager />
      <h1>{entry.agentName}</h1>
      {entry.summary ? (
        <>
          <p class="lede" id={entry.summary.anchor} data-claim-id={entry.summary.id}>{entry.summary.text}</p>
        </>
      ) : (
        <p class="lede">This entry has no summary claim yet.</p>
      )}
      {entry.supportingSystemNote && (
        <div class="notice">
          <strong>Supporting infrastructure</strong>
          <p>{entry.supportingSystemNote}</p>
        </div>
      )}
      <dl class="entry-facts">
        <div>
          <dt>Company</dt>
          <dd>{entry.company}</dd>
        </div>
        <div>
          <dt>Approach type</dt>
          <dd>{entry.approachTypeLabel}</dd>
        </div>
        <div>
          <dt>Work</dt>
          <dd>{entry.domains.map((domain) => domain.label).join(', ')}</dd>
        </div>
        <div>
          <dt>Human involvement</dt>
          <dd>{entry.autonomyLabel}</dd>
        </div>
        {invocation.length > 0 && (
          <div>
            <dt>Invocation</dt>
            <dd>{invocation.map((item) => item.label).join(', ')}</dd>
          </div>
        )}
        {entry.interfaces.length > 0 && (
          <div>
            <dt>Interfaces</dt>
            <dd>{entry.interfaces.map((item) => item.label).join(', ')}</dd>
          </div>
        )}
        <div>
          <dt>Deployment stage</dt>
          <dd>{entry.deploymentStageLabel}</dd>
        </div>
        <div>
          <dt>Evidence strength</dt>
          <dd>{entry.evidenceStrengthLabel}</dd>
        </div>
        <div>
          <dt>Entry reviewed</dt>
          <dd><time datetime={entry.reviewedAt}>{entry.reviewedAt}</time></dd>
        </div>
      </dl>
    </header>

    {hasHowItWorks && (
      <section class="entry-section" id="how-it-works" aria-labelledby="how-it-works-title">
        <h2 id="how-it-works-title">How it works</h2>
        <p class="section-note">The workflow the sources report for this implementation.</p>
        <div class="step-panel">
          {entry.workflowClaims.map((claim) => <Claim claim={claim} showLabel={false} />)}
        </div>
      </section>
    )}

    <section class="entry-section" id="human-involvement" aria-labelledby="human-involvement-title">
      <h2 id="human-involvement-title">Where people stay involved</h2>
      <p class="section-note">
        Each scope pairs its normal attention boundary with supporting evidence. See the
        <a href="/definitions#supervision">supervision definitions</a> for the level mapping and limits.
      </p>
      {entry.isSupportingSystem && !hasHowItWorks && (
        <p class="section-note">
          The catalog records no execution workflow for this entry, so the scopes below describe
          access to the system rather than work it completes on its own.
        </p>
      )}
      {entry.operatingModels.length > 0 && (
        <ul class="scope-list">
          {entry.operatingModels.map((model) => (
            <li>
              <p class="scope-line">
                <Icon name="person" />
                <strong><Arrowed text={model.scope} /></strong>
              </p>
              <span>{model.boundaryLabel} · {model.levelLabel}</span>
            </li>
          ))}
        </ul>
      )}
      {entry.supervisionClaims.map((claim) => (
        <Claim claim={claim} showLabel={false} mark="person" />
      ))}
    </section>

    {hasImplementation && (
      <section class="entry-section" id="implementation" aria-labelledby="implementation-title">
        <h2 id="implementation-title">Implementation details</h2>
        <dl class="architecture">
          {entry.architectureRows.map((row) => (
            <>
              <dt>{row.label}</dt>
              {row.claim ? (
                <dd id={row.claim.anchor} data-claim-id={row.claim.id}>
                  {row.claim.text}
                  {row.claim.caveats.length > 0 && (
                    <span class="architecture-caveats">
                      {row.claim.caveats.map((caveat) => (
                        <span>{caveat.label}: {caveat.value}</span>
                      ))}
                    </span>
                  )}
                </dd>
              ) : (
                <dd class="is-unreported">N/A</dd>
              )}
            </>
          ))}
        </dl>
        {entry.otherClaims.length > 0 && (
          <>
            <h3>Other reported details</h3>
            {entry.otherClaims.map((claim) => <Claim claim={claim} />)}
          </>
        )}
      </section>
    )}

    {hasResults && (
      <section class="entry-section" id="results" aria-labelledby="results-title">
        <h2 id="results-title">Reported results and limitations</h2>
        <p class="section-note">
          The catalog records what the sources report, with the scope and the denominator of every
          figure. A qualification below limits the figure it sits under.
        </p>
        {entry.metricClaims.map((claim) => <Claim claim={claim} />)}
        {entry.resultStatementClaims.length > 0 && (
          <>
            <h3>Reported outcomes and statements</h3>
            {entry.resultStatementClaims.map((claim) => <Claim claim={claim} showKind={true} />)}
          </>
        )}
        {entry.lessonClaims.length > 0 && (
          <>
            <h3>Lessons and interpretation</h3>
            <div class="step-panel">
              {entry.lessonClaims.map((claim) => (
                <Claim claim={claim} showLabel={false} mark="circle-check" />
              ))}
            </div>
          </>
        )}
      </section>
    )}

    <section class="entry-section" id="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources and research details</h2>
      <p class="section-note">
        Citations link to the original publisher. Each source also keeps a preserved copy in the
        repository, so a changed or removed page stays checkable.
      </p>
      <SourceList sources={entry.sources} />
      <ResearchDetails claims={entry.claims} />
    </section>

    <section class="entry-section" id="related" aria-labelledby="related-title">
      <h2 id="related-title">Related reading</h2>
      {hasRelated ? (
        <ul class="related-list">
          {entry.relatedEntries.map((related) => (
            <li class="related-card">
              <span class="related-kind"><Icon name="layers-two" />{related.relationLabel}</span>
              <a href={related.path}>{related.company} — {related.agentName}</a>
            </li>
          ))}
          {entry.relatedNotes.map((note) => (
            <li class="related-card">
              <span class="related-kind"><Icon name="note-text" />Note</span>
              <a href={note.path}>{note.title}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="section-note">The catalog records no related implementation for this entry yet.</p>
      )}
      <a class="page-back page-back-end" href="/">
        <span>Back to the directory</span>
        <Icon name="layers-two" />
      </a>
    </section>
  </article>
</SiteLayout>
