---
// ABOUTME: The page a missing address reaches. It keeps the navigation and a way back.
// ABOUTME: It is excluded from search results, because it is not catalog content.
import SiteLayout from '../layouts/SiteLayout.astro';
import { SITE_NAME } from '../lib/metadata';

const title = `Page not found · ${SITE_NAME}`;
const description = 'This address is not part of the Internal Agents Map catalog.';
---
<SiteLayout title={title} description={description} path="/404" noindex={true}>
  <header class="entry-header">
    <p class="eyebrow">404 / Page not found</p>
    <h1>This page isn’t on the map.</h1>
    <p class="lede">The link may have changed, or the address may be incomplete.</p>
    <div class="resource-links">
      <a href="/">Explore the catalog →</a>
      <a href="/definitions">Read the definitions →</a>
      <a href="/methodology">Read the methodology →</a>
    </div>
  </header>
</SiteLayout>
