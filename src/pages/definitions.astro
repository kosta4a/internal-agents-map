---
// ABOUTME: The Definitions guide: the scope of the map, the chart, and the terms.
// ABOUTME: Chart placements come from the catalog, so lost evidence removes a marker.
import ArticleLayout from '../layouts/ArticleLayout.astro';
import Icon from '../components/Icon.astro';
import Inline from '../components/Inline.astro';
import { loadCatalog } from '../lib/catalog';
import { placements, placementsByCell } from '../lib/definitions';
import {
  ASSISTANT_REFERENCES,
  APPROACH_TYPE_DEFINITIONS,
  DEFINITIONS_CHART,
  DEFINITIONS_DESCRIPTION,
  DEFINITIONS_EYEBROW,
  DEFINITIONS_HEADING,
  DEFINITIONS_INTRO,
  DEFINITIONS_LEDE,
  DEFINITIONS_QUESTIONS,
  DEFINITIONS_SCOPE,
  SUPERVISION_DEFINITIONS,
  DEFINITIONS_TERMS,
  DEFINITIONS_TITLE,
  DEFINITIONS_WORKFLOW,
  INVOCATION_DEFINITIONS,
  READY_REFERENCES,
  REFERENCE_PLACEMENTS,
  inlineHref,
} from '../lib/guide-content';
import { structuredData, webPageNode } from '../lib/metadata';
import { canonicalUrl, guidePath } from '../lib/routes';

const catalog = loadCatalog();
const cells = placementsByCell(catalog);
const placed = placements(catalog);
const reviewed = catalog.approaches
  .map((approach) => approach.last_reviewed_at)
  .sort()
  .at(-1);

const path = guidePath('definitions');
const url = canonicalUrl(path);
const graph = structuredData([
  webPageNode({
    url,
    name: DEFINITIONS_TITLE,
    description: DEFINITIONS_DESCRIPTION,
    dateModified: reviewed,
  }),
]);
const scope = DEFINITIONS_SCOPE;
const workflow = DEFINITIONS_WORKFLOW;
const chart = DEFINITIONS_CHART;
const terms = DEFINITIONS_TERMS;
const questions = DEFINITIONS_QUESTIONS;
const supervision = SUPERVISION_DEFINITIONS;
const [task, work, result] = workflow.steps;
const [breadth, adaptation] = chart.dimensions;
const [localFigure, cloudFigure] = terms.place.figures;
const [foregroundFigure, backgroundFigure] = terms.participation.figures;
---
<ArticleLayout
  title={DEFINITIONS_TITLE}
  description={DEFINITIONS_DESCRIPTION}
  path={path}
  current="definitions"
  structuredData={graph}
>
  <header class="guide-header">
    <p class="eyebrow">{DEFINITIONS_EYEBROW}</p>
    <h1>{DEFINITIONS_HEADING}</h1>
    <p class="lede">{DEFINITIONS_LEDE}</p>
    {DEFINITIONS_INTRO.map((block) => <p><Inline parts={block} /></p>)}
  </header>
  <section id="terms">
    <h2>{scope.heading}</h2>
    <div class="core-definition">
      <p><Inline parts={scope.definition} /></p>
    </div>
    <figure class="scope-figure">
      <svg viewBox="0 0 684 385" role="img" aria-label={scope.diagramLabel} data-signals>
        <rect class="scope-frame" x="0.5" y="0.5" width="683" height="384" rx="15.5"/>
        <text class="scope-label" x="20" y="36">Organization</text>
        <path class="scope-link signal-path" id="scope-link-0" d="M202 192 C 296 192, 340 106, 456 106"/>
        <path class="scope-link signal-path" id="scope-link-1" d="M202 192 C 296 192, 340 192, 456 192"/>
        <path class="scope-link signal-path" id="scope-link-2" d="M202 192 C 296 192, 340 278, 456 278"/>
        <circle class="scope-node scope-agent" cx="190" cy="192" r="10"/>
        <text class="scope-label" x="190" y="168" text-anchor="middle">Agent</text>
        <circle class="scope-node" cx="462" cy="106" r="6"/>
        <circle class="scope-node" cx="462" cy="192" r="6"/>
        <circle class="scope-node" cx="462" cy="278" r="6"/>
        <text class="scope-label" x="484" y="111">Knowledge</text>
        <text class="scope-label" x="484" y="197">Tools</text>
        <text class="scope-label" x="484" y="283">Workflows</text>
        <circle class="signal scope-signal" r="3" data-link="scope-link-0" data-delay="0" opacity="0"/>
        <circle class="signal scope-signal" r="3" data-link="scope-link-1" data-delay=".5" opacity="0"/>
        <circle class="signal scope-signal" r="3" data-link="scope-link-2" data-delay="1" opacity="0"/>
        <circle class="signal scope-signal" r="3" data-link="scope-link-0" data-delay="1.6" data-return opacity="0"/>
        <circle class="signal scope-signal" r="3" data-link="scope-link-1" data-delay="2.1" data-return opacity="0"/>
        <circle class="signal scope-signal" r="3" data-link="scope-link-2" data-delay="2.6" data-return opacity="0"/>
      </svg>
    </figure>
    {scope.body.map((block) => <p><Inline parts={block} /></p>)}
    <h3>{scope.agentHeading}</h3>
    {scope.agentBody.map((block) => <p><Inline parts={block} /></p>)}
  </section>
  <section id="overlap">
    <h2>{workflow.heading}</h2>
    <p><Inline parts={workflow.intro} /></p>
    <figure class="workflow-figure">
      <div class="workflow-stack">
        <div class="workflow-node"><span class="eyebrow">{task.label}</span><strong>{task.value}</strong></div>
        <div class="workflow-connector" aria-hidden="true"><svg viewBox="0 0 12 32"><path d="M6 0 V31 M2 26.5 L6 31 L10 26.5"/></svg></div>
        <div class="workflow-node workflow-context"><span class="eyebrow">{work.label}</span><strong>{work.value}</strong></div>
        <div class="workflow-connector" aria-hidden="true"><svg viewBox="0 0 12 32"><path d="M6 0 V31 M2 26.5 L6 31 L10 26.5"/></svg></div>
        <div class="workflow-node"><span class="eyebrow">{result.label}</span><strong>{result.value}</strong></div>
      </div>
      <figcaption><Inline parts={workflow.caption} /></figcaption>
    </figure>
    <p><Inline parts={workflow.closing} /></p>
    <a class="button" href={inlineHref(workflow.catalogLink)}><span>{workflow.catalogLink.text}</span><Icon name="layers-two" /></a>
  </section>
  <section id="quadrant">
    <h2>{chart.heading}</h2>
    <p><Inline parts={chart.intro} /></p>
    <div class="dimension-intro">
      <div><h3>{breadth.heading}</h3><p><Inline parts={breadth.description} /></p></div>
      <div><h3>{adaptation.heading}</h3><p><Inline parts={adaptation.description} /></p></div>
    </div>
    <figure class="quadrant-figure">
      <div class="quadrant-legend" aria-label="Marker legend"><span><i class="catalog-marker" aria-hidden="true"></i>{chart.legend.catalog}</span><span><i class="reference-marker-key" aria-hidden="true"></i>{chart.legend.reference}</span></div>
      <div class="quadrant-chart">
        <div class="quadrant-y-axis"><span>{chart.verticalAxis.from}</span><span>{chart.verticalAxis.to}</span></div>
        <div class="quadrant-plot">
          <div class="quadrant-cell">
            <h3><span>{chart.cells.specialized.scope}</span>{chart.cells.specialized.title}</h3>
            <ul>
              {cells.specialized.length === 0 && <li>{chart.emptyCell}</li>}
              {cells.specialized.map((item) => (
                <li data-chart-approach-id={item.id}>
                  <a href={item.path} title={item.reason}><strong>{item.company}</strong><span>{item.agentName}</span></a>
                </li>
              ))}
            </ul>
          </div>
          <div class="quadrant-cell">
            <h3><span>{chart.cells.shared.scope}</span>{chart.cells.shared.title}</h3>
            <ul>
              {cells.shared.length === 0 && <li>{chart.emptyCell}</li>}
              {cells.shared.map((item) => (
                <li data-chart-approach-id={item.id}>
                  <a href={item.path} title={item.reason}><strong>{item.company}</strong><span>{item.agentName}</span></a>
                </li>
              ))}
            </ul>
          </div>
          <div class="quadrant-cell">
            <h3><span>{chart.cells.ready.scope}</span>{chart.cells.ready.title}</h3>
            <ul>
              {cells.ready.length === 0 && <li>{chart.emptyCell}</li>}
              {cells.ready.map((item) => (
                <li data-chart-approach-id={item.id}>
                  <a href={item.path} title={item.reason}><strong>{item.company}</strong><span>{item.agentName}</span></a>
                </li>
              ))}
              {READY_REFERENCES.map((item) => (
                <li class="reference-marker" data-chart-reference={item.id}><strong>{item.name}</strong><span>{item.category}</span></li>
              ))}
            </ul>
          </div>
          <div class="quadrant-cell">
            <h3><span>{chart.cells.assistants.scope}</span>{chart.cells.assistants.title}</h3>
            <ul>
              {ASSISTANT_REFERENCES.map((item) => (
                <li class="reference-marker" data-chart-reference={item.id}><strong>{item.name}</strong><span>{item.category}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="quadrant-x-axis"><span>{chart.horizontalAxis.from}</span><span>{chart.horizontalAxis.to}</span></div>
      </div>
      <figcaption><Inline parts={chart.caption} /></figcaption>
    </figure>
    {chart.body.map((block) => <p><Inline parts={block} /></p>)}
    <details class="placement-notes">
      <summary><span>{chart.notesSummary}</span><Icon name="chevron-down" /></summary>
      <ul>
        {placed.map((item) => (
          <li>
            <strong>{item.company} · {item.agentName}</strong>
            <p>{item.reason}</p>
            <div>
              {item.evidence.map((link, index) => (
                <>{index > 0 && ' · '}<a href={link.href}>{link.label}</a></>
              ))}
            </div>
          </li>
        ))}
        {REFERENCE_PLACEMENTS.map((item) => (
          <li class="reference-placement">
            <strong>Reference · {item.name}</strong>
            <p>{item.reason}</p>
            <div>
              {item.links.map((link, index) => (
                <>{index > 0 && ' · '}<a href={link.url}><Icon name="arrow-upright" />{link.label}</a></>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </details>
    <h3>{chart.builtHeading}</h3>
    {chart.builtBody.map((block) => <p><Inline parts={block} /></p>)}
  </section>
  <section id="supervision">
    <h2>{supervision.heading}</h2>
    <p><Inline parts={supervision.intro} /></p>
    <p><Inline parts={supervision.source} /></p>
    <div class="classification-table" role="region" aria-label="Supervision levels" tabindex="0">
      <table>
        <thead><tr><th>Boundary</th><th>Level</th><th>Human attention</th><th>Interpretation</th></tr></thead>
        <tbody>
          {supervision.rows.map((row) => (
            <tr><th scope="row">{row.label}</th><td>{row.level}</td><td>{row.attention}</td><td>{row.meaning}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p><Inline parts={supervision.limits} /></p>
    <p><Inline parts={supervision.scope} /></p>
    <h3>Structural types</h3>
    <p>Structural type answers what kind of system the entry describes. It is independent of how work starts.</p>
    <dl class="term-definitions">
      {APPROACH_TYPE_DEFINITIONS.map((item) => <div><dt>{item.label}</dt><dd>{item.meaning}</dd></div>)}
    </dl>
    <h3>Invocation modes</h3>
    <p>Invocation answers how work starts or proceeds. One system can support several modes.</p>
    <dl class="term-definitions">
      {INVOCATION_DEFINITIONS.map((item) => <div><dt>{item.label}</dt><dd>{item.meaning}</dd></div>)}
    </dl>
  </section>
  <section id="terminology">
    <h2>{terms.heading}</h2>
    <p><Inline parts={terms.intro} /></p>
    <h3>{terms.place.heading}</h3>
    <p class="concept-definition"><Inline parts={terms.place.definition} /></p>
    <div class="place-panels">
      <figure class="place-panel">
        <figcaption><strong>{localFigure.term}</strong><span>{localFigure.caption}</span></figcaption>
        <div class="place-scene" role="img" aria-label={localFigure.label}>
          <div class="place-machine">
            <span class="place-machine-title">Your computer</span>
            <div class="place-box"><i class="place-agent-dot" aria-hidden="true"></i></div>
            <span class="place-callout"><svg viewBox="0 0 12 74" aria-hidden="true"><path d="M6 74 V1 M2 5.5 L6 1 L10 5.5"/></svg><span>Agent runs here</span></span>
          </div>
        </div>
      </figure>
      <figure class="place-panel">
        <figcaption><strong>{cloudFigure.term}</strong><span>{cloudFigure.caption}</span></figcaption>
        <div class="place-scene" role="img" aria-label={cloudFigure.label}>
          <div class="place-machine">
            <span class="place-machine-title">Your computer</span>
            <div class="place-box"></div>
          </div>
          <div class="place-link">
            <span class="place-machine-title"></span>
            <svg class="place-arrow" viewBox="0 0 64 12" aria-hidden="true"><path d="M7 6 H57 M7 6 L13 2 M7 6 L13 10 M57 6 L51 2 M57 6 L51 10"/></svg>
          </div>
          <div class="place-machine">
            <span class="place-machine-title">Remote computer</span>
            <div class="place-box"><i class="place-agent-dot" aria-hidden="true"></i></div>
            <span class="place-callout"><svg viewBox="0 0 12 74" aria-hidden="true"><path d="M6 74 V1 M2 5.5 L6 1 L10 5.5"/></svg><span>Agent runs here</span></span>
          </div>
        </div>
      </figure>
    </div>
    {terms.place.body.map((block) => <p><Inline parts={block} /></p>)}
    <h3>{terms.participation.heading}</h3>
    <p class="concept-definition"><Inline parts={terms.participation.definition} /></p>
    <div class="place-panels">
      <figure class="place-panel">
        <figcaption><strong>{foregroundFigure.term}</strong><span>{foregroundFigure.caption}</span></figcaption>
        <div class="place-scene place-scene-wide" role="img" aria-label={foregroundFigure.label}>
          <svg class="exchange-scene" viewBox="0 0 652 280" aria-hidden="true" data-signals="5">
            <path class="exchange-strand" id="exchange-0" d="M66 130 H160 C 250 130, 250 50, 326 50 C 402 50, 402 130, 492 130 H586"/>
            <path class="exchange-strand" id="exchange-1" d="M66 130 H586"/>
            <path class="exchange-strand" id="exchange-2" d="M66 130 H160 C 250 130, 250 210, 326 210 C 402 210, 402 130, 492 130 H586"/>
            <circle class="exchange-you" cx="56" cy="130" r="10"/>
            <circle class="exchange-agent" cx="596" cy="130" r="10"/>
            <circle class="signal exchange-signal" r="3" data-link="exchange-0" data-delay="0" opacity="0"/>
            <circle class="signal exchange-signal" r="3" data-link="exchange-1" data-delay=".5" opacity="0"/>
            <circle class="signal exchange-signal" r="3" data-link="exchange-2" data-delay="1" opacity="0"/>
            <circle class="signal exchange-signal" r="3" data-link="exchange-0" data-delay="1.6" data-return opacity="0"/>
            <circle class="signal exchange-signal" r="3" data-link="exchange-1" data-delay="2.1" data-return opacity="0"/>
            <circle class="signal exchange-signal" r="3" data-link="exchange-2" data-delay="2.6" data-return opacity="0"/>
            <text class="scope-label" x="56" y="170" text-anchor="middle">You</text>
            <text class="scope-label" x="596" y="170" text-anchor="middle">Agent</text>
          </svg>
        </div>
      </figure>
      <figure class="place-panel">
        <figcaption><strong>{backgroundFigure.term}</strong><span>{backgroundFigure.caption}</span></figcaption>
        <div class="place-scene place-scene-wide" role="img" aria-label={backgroundFigure.label}>
          <svg class="cycle-scene" viewBox="0 0 668 280" aria-hidden="true">
            <path class="cycle-link" id="cycle-in" d="M0 140 H126"/>
            <path class="cycle-link" id="cycle-work" d="M154 140 H302"/>
            <path class="cycle-link" id="cycle-out" d="M350 140 H566"/>
            <circle class="cycle-trigger" cx="140" cy="140" r="12"/>
            <circle class="cycle-trigger-on" cx="140" cy="140" r="12" opacity="0"/>
            <circle class="cycle-agent" cx="326" cy="140" r="22"/>
            <path class="cycle-spinner" d="M326 128 A12 12 0 0 1 338 140" opacity="0"/>
            <circle class="cycle-result" cx="580" cy="140" r="12"/>
            <circle class="cycle-result-dot" cx="580" cy="140" r="6" opacity="0"/>
            <circle class="cycle-signal" r="4" opacity="0"/>
            <text class="scope-label" x="140" y="186" text-anchor="middle">Trigger</text>
            <text class="scope-label" x="326" y="186" text-anchor="middle">Agent</text>
            <text class="scope-label" x="580" y="186" text-anchor="middle">Result</text>
          </svg>
        </div>
      </figure>
    </div>
    {terms.participation.body.map((block) => <p><Inline parts={block} /></p>)}
    <aside class="concept-combination"><p class="combination-title">{terms.combination.label}<br /><Inline parts={terms.combination.lede} /></p><dl>{terms.combination.pairs.map((pair) => <div><dt>{pair.label}</dt><dd>{pair.value}</dd></div>)}</dl><p class="combination-note">{terms.combination.note}</p></aside>
    <h3 id={terms.autonomy.id}>{terms.autonomy.heading}</h3>
    {terms.autonomy.body.map((block) => <p><Inline parts={block} /></p>)}
    <blockquote>{terms.autonomy.quote}</blockquote>
    <p><Inline parts={terms.autonomy.closing} /></p>
  </section>
  <section id="faq" class="guide-faq">
    <h2>{questions.heading}</h2>
    {questions.items.map((item) => (
      <details>
        <summary><span>{item.question}</span><Icon name="chevron-down" /></summary>
        <p><Inline parts={item.answer} /></p>
      </details>
    ))}
  </section>
</ArticleLayout>
<script>
  import { startSignals } from '../scripts/signals';
  import { startWorkCycle } from '../scripts/work-cycle';

  startSignals();
  startWorkCycle();
</script>
